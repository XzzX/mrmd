@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Kokkos)
find_dependency(Cabana)

set(MRMD_ENABLE_MPI @MRMD_ENABLE_MPI@)
set(MRMD_ENABLE_HDF5 @MRMD_ENABLE_HDF5@)

if (MRMD_ENABLE_MPI)
    find_dependency(MPI COMPONENTS C CXX)
endif ()
if (MRMD_ENABLE_HDF5)
    find_dependency(HDF5 COMPONENTS C HL)
endif ()

include("${CMAKE_CURRENT_LIST_DIR}/mrmdTargets.cmake")
check_required_components(mrmd)
