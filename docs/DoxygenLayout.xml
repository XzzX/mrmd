<?xml version="1.0" encoding="UTF-8"?>
<!-- Minimal layout: only the navigation index is customized. Everything else falls
     back to Doxygen's built-in defaults, which keeps this file portable across
     Doxygen versions.

     Do NOT replace this with the output of `doxygen -l`. A full dump pins the file
     to one Doxygen version, and docs/Doxyfile.in sets WARN_AS_ERROR = YES, so the
     first tag an older Doxygen does not know turns into a failed docs build. -->
<doxygenlayout version="1.0">
  <navindex>
    <!-- Getting Started, Concept, Theory and Tutorials are \subpage entries of the
         main page, so they already appear below it in the navigation tree, nested
         and with their own section headings. Listing them here as well would show
         each of them twice, once without its children. -->
    <tab type="mainpage" visible="yes" title="Overview"/>
    <tab type="usergroup" title="API reference">
      <tab type="namespaces" visible="yes" title="">
        <tab type="namespacelist"    visible="yes" title="" intro=""/>
        <tab type="namespacemembers" visible="yes" title="" intro=""/>
      </tab>
      <tab type="classes" visible="yes" title="">
        <tab type="classlist"    visible="yes" title="" intro=""/>
        <tab type="classmembers" visible="yes" title="" intro=""/>
      </tab>
      <tab type="files" visible="yes" title="">
        <tab type="filelist" visible="yes" title="" intro=""/>
        <tab type="globals"  visible="yes" title="" intro=""/>
      </tab>
    </tab>
  </navindex>
</doxygenlayout>
