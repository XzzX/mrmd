# Doxygen configuration for MRMD. Only non-default values are listed.
# Configured by CMake, see docs/CMakeLists.txt.

PROJECT_NAME           = MRMD
PROJECT_NUMBER         = @PROJECT_VERSION@
PROJECT_BRIEF          = "@PROJECT_DESCRIPTION@"
OUTPUT_DIRECTORY       = @CMAKE_CURRENT_BINARY_DIR@
STRIP_FROM_PATH        = @PROJECT_SOURCE_DIR@
STRIP_FROM_INC_PATH    = @PROJECT_SOURCE_DIR@/mrmd

#---------------------------------------------------------------------------
# Build and input
#
# WARN_AS_ERROR = YES means any warning fails the docs build, including ones
# that come from a file written for a different Doxygen version. Keep
# DoxygenLayout.xml and header.html version neutral, and do not add tags that
# only exist in a newer Doxygen than the one CI installs.
#---------------------------------------------------------------------------
EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES
QUIET                  = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = YES
INPUT                  = @CMAKE_BINARY_DIR@/docs/tutorials.dox \
                         @PROJECT_SOURCE_DIR@/docs \
                         @PROJECT_SOURCE_DIR@/examples \
                         @PROJECT_SOURCE_DIR@/mrmd
FILE_PATTERNS          = *.hpp *.cpp *.md *.dox
RECURSIVE              = YES
EXCLUDE_PATTERNS       = *.test.cpp \
                         */mrmd/test/* \
                         */gtest_main*
# data::impl holds GeneralAtoms/GeneralMolecules, the real definitions behind
# data::Atoms and data::Molecules, so it has to stay visible. Everything else
# called impl really is an implementation detail.
EXCLUDE_SYMBOLS        = mrmd::action::impl* \
                         mrmd::analysis::impl* \
                         mrmd::communication::impl* \
                         mrmd::io::impl* \
                         mrmd::util::impl* \
                         mrmd::weighting_function::impl*
EXAMPLE_PATH           = @PROJECT_SOURCE_DIR@
JAVADOC_AUTOBRIEF      = YES
FILTER_PATTERNS        = *examples*.cpp="python3 @CMAKE_CURRENT_SOURCE_DIR@/tutorial_filter.py"
LAYOUT_FILE            = @CMAKE_CURRENT_SOURCE_DIR@/DoxygenLayout.xml

#---------------------------------------------------------------------------
# HTML output with doxygen-awesome-css
#---------------------------------------------------------------------------
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO
# wide enough for the longest tutorial title in the sidebar
TREEVIEW_WIDTH         = 335
HTML_COLORSTYLE        = LIGHT
HTML_HEADER            = @CMAKE_CURRENT_SOURCE_DIR@/header.html
HTML_EXTRA_STYLESHEET  = @AWESOME_CSS_DIR@/doxygen-awesome.css \
                         @AWESOME_CSS_DIR@/doxygen-awesome-sidebar-only.css \
                         @AWESOME_CSS_DIR@/doxygen-awesome-sidebar-only-darkmode-toggle.css
HTML_EXTRA_FILES       = @AWESOME_CSS_DIR@/doxygen-awesome-darkmode-toggle.js \
                         @AWESOME_CSS_DIR@/doxygen-awesome-fragment-copy-button.js
USE_MATHJAX            = YES

#---------------------------------------------------------------------------
# Diagrams
#---------------------------------------------------------------------------
HAVE_DOT               = @MRMD_DOXYGEN_HAVE_DOT@
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
